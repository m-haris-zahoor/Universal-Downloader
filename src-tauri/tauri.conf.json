{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Universal Downloader",
  "version": "1.0.0",
  "identifier": "com.universaldownloader.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Universal Downloader", "width": 1120, "height": 740, "minWidth": 900, "minHeight": 600, "center": true }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost" }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "resources": { "resources/bin/": "bin/" },
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "11.0" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
